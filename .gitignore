# ===========================================================================
# PlantGuard - credentials and generated config
# ===========================================================================

# A REAL SECRET. This holds the EmailJS access token; anyone who has it can
# send mail through the account up to its quota. Copy
# lib/otp_config.dart.example to lib/otp_config.dart and fill it in locally.
lib/otp_config.dart

# Firebase client config.
#
# To be accurate: these are not secrets in the classic sense. Google designs
# them to ship inside the app binary, and your real protection is Firestore
# security rules plus App Check - not the obscurity of these files.
#
# They are excluded anyway for one practical reason: this repo is private now
# but may go public later, and anything committed stays in git history
# permanently. Keeping them out now means that switch costs nothing.
#
# On a fresh clone, regenerate them with:  flutterfire configure
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
firebase.json
.firebaserc

# Android signing material. A leaked keystore lets someone else publish an
# update that your users' phones accept as genuine. There is no recovery from
# this other than a new app listing.
android/key.properties
**/*.jks
**/*.keystore

# ---------------------------------------------------------------------------
# Catch-all for credentials added later. Cheaper than remembering.
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.p8
*.p12
*secrets.dart
*_secret.dart
*_secrets.dart
api_keys.dart
**/service-account*.json
**/serviceAccountKey*.json
